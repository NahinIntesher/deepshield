CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Hosted database: keep the real URL in .env only; SQLite is the local fallback.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/deepshield?sslmode=require
EXTENSION_ORIGINS=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FREE_DAILY_SCANS=10
PREMIUM_DAILY_SCANS=100
PREMIUM_PRICE_BDT=299
MAX_PENDING_SCANS=12
BKASH_PAYMENT_NUMBER=01815808291
PAYMENT_INSTRUCTIONS=Pay the displayed Premium price to the bKash number, then submit your transaction ID. An administrator must verify the payment before activation. Never share your PIN or OTP.
# Optional: use forward slashes in Windows paths.
# CHECKPOINT_PATH=D:/DeepShield/model/best_model.pth
# INSIGHTFACE_ROOT=C:/Users/YOUR_NAME/.insightface
FACE_PROVIDER=CPUExecutionProvider
GOOGLE_CLIENT_ID=
# Private hosted inference. Leave MODEL_SPACE_ID empty for the local model.
MODEL_SPACE_ID=
MODEL_SPACE_TOKEN=
MODEL_CHECKPOINT_SHA256=be33edbb69a80072439b8ea361ee9b00f635a2604ea2a4b9c1bfabe731067b7e
MEDIA_STORAGE_ENABLED=false
MEDIA_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
